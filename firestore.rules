rules_version = '2';
// 연과 도깨비불 랜딩 — 사전예약만 받는다.
// 방문자는 '새 예약 한 건 만들기'만 가능. 읽기·수정·삭제는 아무도 못 함(관리는 콘솔/관리자 도구로만).
service cloud.firestore {
  match /databases/{db}/documents {
    match /preregistrations/{id} {
      allow read, update, delete: if false;
      allow create: if id.matches('^[0-9a-f]{64}$')            // 번호의 SHA-256 → 같은 번호 중복 방지
        && request.resource.data.keys().hasOnly(['phone', 'platform', 'age14', 'agreePrivacy', 'agreeAds', 'consentVersion', 'lang', 'createdAt'])
        && request.resource.data.keys().hasAll(['phone', 'platform', 'age14', 'agreePrivacy', 'agreeAds', 'consentVersion', 'lang', 'createdAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^01[016789][0-9]{7,8}$')
        && request.resource.data.platform in ['ios', 'android', 'pc']
        && request.resource.data.age14 == true
        && request.resource.data.agreePrivacy == true
        && request.resource.data.agreeAds == true
        && request.resource.data.consentVersion is string && request.resource.data.consentVersion.size() <= 32
        && request.resource.data.lang in ['ko', 'en']
        && request.resource.data.createdAt == request.time;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
